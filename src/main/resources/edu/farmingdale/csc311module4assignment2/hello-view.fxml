<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.AnchorPane?>
<VBox spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="edu.farmingdale.csc311module4assignment2.HelloController">
    <HBox fx:id="top_box" prefHeight="40" prefWidth="600" spacing="80.0">
        <Button fx:id="solution" text="Find a Solution" prefHeight="40" prefWidth="100"></Button>
        <TextArea fx:id="mirror" prefHeight="40" prefWidth="140" editable="false"></TextArea>
        <Button fx:id="refresh" text="Refresh" prefHeight="40" prefWidth="100" onAction="#redraw"></Button>
    </HBox>
    <HBox prefWidth="500" prefHeight="180">
        <ImageView fx:id="card1" preserveRatio="true" fitHeight="180">
            <Image url="@PlayingCards/png/ace_of_spades.png"/>
        </ImageView>
        <ImageView fx:id="card2" preserveRatio="true" fitHeight="180">
            <Image url="@PlayingCards/png/ace_of_spades.png"/>
        </ImageView>
        <ImageView fx:id="card3" preserveRatio="true" fitHeight="180">
            <Image url="@PlayingCards/png/ace_of_spades.png"/>
        </ImageView>
        <ImageView fx:id="card4" preserveRatio="true" fitHeight="180">
            <Image url="@PlayingCards/png/ace_of_spades.png"/>
        </ImageView>
    </HBox>
    <HBox prefWidth="500" prefHeight="40" spacing="30.0">
        <Label text="Enter an Expression:" style="-fx-font-size: 23px;"></Label>
        <TextArea fx:id="answer" prefHeight="40" prefWidth="140" style="-fx-font-size: 16px;"></TextArea>
        <Button fx:id="verify" prefHeight="40" prefWidth="97" text="verify" onAction="#checkSolution"></Button>
    </HBox>
</VBox>
